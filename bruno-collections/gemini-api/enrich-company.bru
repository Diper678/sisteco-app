meta {
  name: Enrich Company (Datos Empresa Chilena)
  type: http
  seq: 2
}

post {
  url: https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent?key={{gemini_api_key}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "contents": [
      {
        "parts": [
          {
            "text": "Return ONLY compact JSON (no whitespace, no prose). Enrich: {\"empresa\":\"Empresa Tecnologica Ltda\",\"rut\":\"76.123.456-7\"}. Schema: {\"giro\":\"\",\"tamano\":\"\",\"region\":\"\",\"senalesCompra\":[\"\"]}"
          }
        ]
      }
    ],
    "generationConfig": {
      "temperature": 0.1,
      "maxOutputTokens": 256
    }
  }
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("candidates[0].content.parts[0].text existe", function() {
    const data = res.getBody();
    const text = data?.candidates?.[0]?.content?.parts?.[0]?.text;
    expect(text).to.be.a("string").with.lengthOf.at.least(1);
  });

  test("Respuesta tiene estructura de enriquecimiento", function() {
    const data = res.getBody();
    const rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text || "";
    // Extraer primer bloque JSON del texto (Gemini a veces agrega prosa antes)
    const jsonMatch = rawText.match(/\{[\s\S]*\}/);
    expect(jsonMatch, "No se encontró JSON en la respuesta").to.not.be.null;
    const parsed = JSON.parse(jsonMatch[0]);
    expect(parsed).to.have.property("giro");
    expect(parsed).to.have.property("tamano");
  });
}
