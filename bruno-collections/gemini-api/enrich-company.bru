meta {
  name: Enrich Company (Datos Empresa Chilena)
  type: http
  seq: 2
}

post {
  url: https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={{gemini_api_key}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "contents": [
      {
        "parts": [
          {
            "text": "Eres un asistente de enriquecimiento de datos B2B para empresas chilenas.\nDado el nombre de una empresa y su RUT, genera informacion de contexto para calificarla como prospecto de ventas B2B.\nEmpresa: \"Empresa Tecnologica Ltda\"\nRUT: \"76.123.456-7\"\nResponde en JSON con este formato exacto (sin texto adicional fuera del JSON):\n{ \"giro\": \"string (rubro o industria principal, max 50 caracteres)\",\n  \"tamano\": \"string (estimacion: 'Micro <10', 'Pequeña 10-50', 'Mediana 50-200', 'Grande 200+')\",\n  \"region\": \"string (region de Chile donde opera, o 'Nacional' si es multi-regional)\",\n  \"señalesCompra\": [\"string\", \"string\"] }"
          }
        ]
      }
    ],
    "generationConfig": {
      "responseMimeType": "application/json",
      "temperature": 0.2,
      "maxOutputTokens": 256
    }
  }
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("candidates[0].content.parts[0].text existe", function() {
    const data = res.getBody();
    const text = data?.candidates?.[0]?.content?.parts?.[0]?.text;
    expect(text).to.be.a("string").with.lengthOf.at.least(1);
  });

  test("Respuesta tiene estructura de enriquecimiento", function() {
    const data = res.getBody();
    const rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text;
    const parsed = JSON.parse(rawText);
    expect(parsed).to.have.property("giro");
    expect(parsed).to.have.property("tamano");
  });
}
