      "id": "t2-00000000-0000-4000-a000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body = item.body || item;\nlet rut = (body.rut || '').toString();\n\n// Clean format\nrut = rut.replace(/\\./g, '').replace(/-/g, '');\n\nif (!rut || rut.length < 8) {\n  return [{ json: { ...body, rut_cuerpo: null, rut_dv: null, rut_limpio: null, has_rut: false } }];\n}\n\nconst dv = rut.slice(-1).toUpperCase();\nconst cuerpo = rut.slice(0, -1);\n\nif (!cuerpo || cuerpo.length < 7 || isNaN(Number(cuerpo))) {\n  return [{ json: { ...body, rut_cuerpo: null, rut_dv: null, rut_limpio: null, has_rut: false } }];\n}\n\nreturn [{\n  json: {\n    ...body,\n    rut_cuerpo: cuerpo,\n    rut_dv: dv,\n    rut_limpio: cuerpo + '-' + dv,\n    has_rut: true\n  }\n}];"
      },
      "id": "t2-00000000-0000-4000-a000-000000000002",
      "name": "Parse RUT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-has-rut",
              "leftValue": "={{ $json.has_rut }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
