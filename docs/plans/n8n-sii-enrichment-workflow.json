      },
      "id": "t2-00000000-0000-4000-a000-000000000005",
      "name": "SimpleAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 180],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const original = $('Parse RUT').first().json;\nlet siiData = {};\nlet simpleData = {};\n\ntry { siiData = $('SII Consulta').first().json || {}; } catch(e) {}\ntry { simpleData = $('SimpleAPI').first().json || {}; } catch(e) {}\n\nreturn [{\n  json: {\n    empresa: original.empresa || simpleData.razon_social || null,\n    rut: original.rut_limpio,\n    email: original.email || null,\n    cliente_id: original.cliente_id || 'default',\n    razon_social: simpleData.razon_social || null,\n    giro: simpleData.giro || simpleData.actividad_economica || null,\n    estado_tributario: simpleData.estado || null,\n    inicio_actividades: simpleData.inicio_actividades || null,\n    region: simpleData.region || null,\n    comuna: simpleData.comuna || null,\n    tramo_ventas: simpleData.tramo_ventas || null,\n    rango_trabajadores: simpleData.rango_trabajadores || null,\n    enriquecido_en: new Date().toISOString(),\n    fuente: 'SII + SimpleAPI'\n  }\n}];"
      },
      "id": "t2-00000000-0000-4000-a000-000000000006",
      "name": "Merge SII Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "jsCode": "const original = $('Parse RUT').first().json;\n\nreturn [{\n  json: {\n    empresa: original.empresa || null,\n    rut: null,\n    email: original.email || null,\n    cliente_id: original.cliente_id || 'default',\n    razon_social: null,\n    giro: null,\n    estado_tributario: null,\n    inicio_actividades: null,\n    region: null,\n    comuna: null,\n    tramo_ventas: null,\n    rango_trabajadores: null,\n    enriquecido_en: new Date().toISOString(),\n    fuente: 'sin_rut'\n  }\n}];"
      },
      "id": "t2-00000000-0000-4000-a000-000000000007",
      "name": "Lead Parcial",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"contents\":[{\"parts\":[{\"text\":\"Evalúa este lead B2B SaaS chileno del 1-10. Responde SOLO JSON con score (numero), razon (texto corto), categoria (caliente/tibio/frio).\\n\\nEmpresa: {{ $json.empresa }}\\nGiro: {{ $json.giro }}\\nTramo ventas: {{ $json.tramo_ventas }}\\nRegión: {{ $json.region }}\\nEstado: {{ $json.estado_tributario }}\\nInicio actividades: {{ $json.inicio_actividades }}\"}]}],\"generationConfig\":{\"responseMimeType\":\"application/json\"}}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "t2-00000000-0000-4000-a000-000000000008",
      "name": "Gemini ICP Score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300],
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "jsCode": "const respuesta = $input.first().json;\nlet scoring = { score: null, razon: 'Error parsing', categoria: 'sin_score' };\n\ntry {\n  // Gemini 2.5 Flash response: candidates[0].content.parts[0].text\n  const candidates = respuesta.candidates || [];\n  if (candidates.length > 0) {\n    const texto = candidates[0].content.parts[0].text;\n    const limpio = texto.replace(/```json|```/g, '').trim();\n    scoring = JSON.parse(limpio);\n  }\n} catch(e) {\n  // Keep default scoring\n}\n\n// Get the enriched data from before Gemini scoring\nlet enriched = {};\ntry { enriched = $('Merge SII Data').first().json; } catch(e) {}\ntry { if (!enriched.empresa) enriched = $('Lead Parcial').first().json; } catch(e) {}\n\nreturn [{\n  json: {\n    ...enriched,\n    score_icp: scoring.score,\n    score_razon: scoring.razon,\n    score_categoria: scoring.categoria\n  }\n}];"
      },
