    {
      "parameters": {
        "jsCode": "// Filter leads eligible for HubSpot sync\nconst config = $('Client Config').first().json;\nconst threshold = config.syncThreshold || 50;\nconst items = $input.all();\nconst eligible = [];\n\nfor (const item of items) {\n  const lead = item.json;\n  const status = (lead.status || '').trim();\n  const score = parseInt(lead.score, 10) || 0;\n  const categoria = (lead.categoria || '').trim().toUpperCase();\n\n  // Only sync leads that are Nuevo or Prioridad, above threshold, and HOT or WARM\n  const isEligibleStatus = (status === 'Nuevo' || status === 'Prioridad');\n  const isAboveThreshold = score >= threshold;\n  const isEligibleCategory = (categoria === 'HOT' || categoria === 'WARM');\n\n  if (isEligibleStatus && isAboveThreshold && isEligibleCategory) {\n    // Split contacto into firstname + lastname\n    const fullName = (lead.contacto || '').trim();\n    const nameParts = fullName.split(/\\s+/);\n    const firstName = nameParts[0] || '';\n    const lastName = nameParts.slice(1).join(' ') || '';\n\n    // Map categoria to HubSpot lifecyclestage\n    let lifecyclestage = 'lead';\n    if (categoria === 'HOT') lifecyclestage = 'salesqualifiedlead';\n    else if (categoria === 'WARM') lifecyclestage = 'marketingqualifiedlead';\n\n    eligible.push({\n      json: {\n        // Original fields\n        empresa: lead.empresa || '',\n        contacto: fullName,\n        cargo: lead.cargo || '',\n        email: (lead.email || '').trim(),\n        linkedin: (lead.linkedin || '').trim(),\n        website: lead.website || '',\n        industria: lead.industria || '',\n        ubicacion: lead.ubicacion || '',\n        score: score,\n        categoria: categoria,\n        status: status,\n        fecha: lead.fecha || '',\n        source: lead.source || '',\n        // HubSpot mapped fields\n        hs_firstname: firstName,\n        hs_lastname: lastName,\n        hs_lifecyclestage: lifecyclestage,\n        // Row number for later update (1-indexed, +2 for header)\n        _rowNumber: item.json.row_number || item.pairedItem?.item || 0\n      }\n    });\n  }\n}\n\nif (eligible.length === 0) {\n  return [{ json: { _empty: true, _message: 'No eligible leads to sync' } }];\n}\n\nreturn eligible;"
      },
