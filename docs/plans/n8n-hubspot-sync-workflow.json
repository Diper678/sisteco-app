    {
      "parameters": {
        "jsCode": "// Extract new contact ID and prepare deal creation for HOT leads\nconst lead = $('Check Contact Exists').first().json;\nconst createResult = $input.first().json;\n\nlet hubspotContactId = null;\ntry {\n  hubspotContactId = createResult.id || null;\n} catch (e) {\n  // Contact creation may have failed\n}\n\nconst needsDeal = lead.categoria === 'HOT' && hubspotContactId;\n\nreturn [{\n  json: {\n    ...lead,\n    _hubspotContactId: hubspotContactId,\n    _needsDeal: needsDeal,\n    _syncAction: hubspotContactId ? 'created' : 'failed'\n  }\n}];"
      },
