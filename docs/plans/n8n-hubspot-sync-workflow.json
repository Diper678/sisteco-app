    {
      "parameters": {
        "jsCode": "// Check if HubSpot returned an existing contact\nconst lead = $('Prepare Search').first().json;\nconst searchResult = $input.first().json;\n\nlet contactExists = false;\nlet hubspotContactId = null;\n\ntry {\n  if (searchResult.total && searchResult.total > 0 && searchResult.results && searchResult.results.length > 0) {\n    contactExists = true;\n    hubspotContactId = searchResult.results[0].id;\n  }\n} catch (e) {\n  // Search failed or unexpected format — treat as not found\n  contactExists = false;\n}\n\nreturn [{\n  json: {\n    ...lead,\n    _contactExists: contactExists,\n    _hubspotContactId: hubspotContactId\n  }\n}];"
      },
