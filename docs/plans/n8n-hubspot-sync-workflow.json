      "id": "f8a9b0c1-d2e3-4567-fabc-678901234fab",
      "name": "HubSpot Create Deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3120, 240],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Assign deal to sales rep using round-robin\nconst config = $('Client Config').first().json;\nconst lead = $('Extract Contact ID').first().json;\nconst dealResult = $input.first().json;\n\nlet dealId = null;\ntry {\n  dealId = dealResult.id || null;\n} catch (e) {}\n\n// Round-robin assignment\nconst reps = config.salesReps || [];\nlet assignedRep = '';\nif (reps.length > 0) {\n  const idx = (config.currentRepIndex || 0) % reps.length;\n  assignedRep = reps[idx];\n  // Note: currentRepIndex should be incremented externally or via static data\n}\n\nreturn [{\n  json: {\n    ...lead,\n    _hubspotDealId: dealId,\n    _assignedRep: assignedRep,\n    _syncAction: 'created_with_deal'\n  }\n}];"
      },
      "id": "a9b0c1d2-e3f4-5678-abcd-789012345abc",
      "name": "Assign Rep",
      "type": "n8n-nodes-base.code",
