    {
      "parameters": {
        "jsCode": "// Determine search identifier: prefer email, fallback to LinkedIn URL\nconst lead = $input.first().json;\nlet searchValue = '';\nlet searchField = '';\n\nif (lead.email && lead.email.length > 3 && lead.email.includes('@')) {\n  searchValue = lead.email;\n  searchField = 'email';\n} else if (lead.linkedin && lead.linkedin.length > 5) {\n  searchValue = lead.linkedin;\n  searchField = 'hs_linkedin_url';\n} else {\n  // No valid identifier — skip this lead\n  return [{ json: { ...lead, _skipSync: true, _skipReason: 'No email or LinkedIn URL' } }];\n}\n\nreturn [{ json: { ...lead, _searchValue: searchValue, _searchField: searchField } }];"
      },
