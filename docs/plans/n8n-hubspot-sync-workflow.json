        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"dealname\": \"{{ $json.empresa }} \\u2014 Oportunidad Sisteco\",\n    \"pipeline\": \"default\",\n    \"dealstage\": \"appointmentscheduled\",\n    \"amount\": \"0\",\n    \"description\": \"Lead generado por Sisteco Pipeline. Score: {{ $json.score }}/100. Categoria: {{ $json.categoria }}. Contacto: {{ $json.contacto }} ({{ $json.cargo }})\",\n    \"sisteco_score\": \"{{ $json.score }}\"\n  },\n  \"associations\": [\n    {\n      \"to\": {\n        \"id\": \"{{ $json._hubspotContactId }}\"\n      },\n      \"types\": [\n        {\n          \"associationCategory\": \"HUBSPOT_DEFINED\",\n          \"associationTypeId\": 3\n        }\n      ]\n    }\n  ]\n}",
        "options": {
