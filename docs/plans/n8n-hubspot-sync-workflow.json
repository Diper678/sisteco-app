      "typeVersion": 1,
      "position": [3120, 460]
    },
    {
      "parameters": {
        "jsCode": "// Merge all sync paths into unified output for sheet update\nconst items = $input.all();\nconst result = items[0].json;\n\n// Build the final sync record\nconst syncDate = new Date().toISOString().substring(0, 10);\nconst hubspotId = result._hubspotContactId || 'SYNC_ERROR';\nconst action = result._syncAction || 'unknown';\nconst dealId = result._hubspotDealId || '';\nconst assignedRep = result._assignedRep || '';\n\nreturn [{\n  json: {\n    ...result,\n    _finalStatus: 'Synced to CRM',\n    _syncDate: syncDate,\n    _hubspotContactId: hubspotId,\n    _hubspotDealId: dealId,\n    _assignedRep: assignedRep,\n    _syncAction: action\n  }\n}];"
      },
