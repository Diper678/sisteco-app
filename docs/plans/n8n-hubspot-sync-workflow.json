    {
      "parameters": {
        "amount": 0.5,
        "unit": "seconds"
      },
      "id": "e3f4a5b6-c7d8-9012-efab-123456789efa",
      "name": "Rate Limit",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [4000, 300]
    },
    {
      "parameters": {
        "jsCode": "// Collect sync summary across all iterations\n// This node runs after the loop completes\nconst allItems = $input.all();\nconst summary = {\n  totalSynced: 0,\n  created: 0,\n  updated: 0,\n  failed: 0,\n  hotLeadsSynced: 0,\n  dealsCreated: 0,\n  leads: []\n};\n\nfor (const item of allItems) {\n  const data = item.json;\n  if (data._empty || data._skipSync) continue;\n\n  summary.totalSynced++;\n  if (data._syncAction === 'created' || data._syncAction === 'created_with_deal') summary.created++;\n  else if (data._syncAction === 'updated') summary.updated++;\n  else summary.failed++;\n\n  if (data.categoria === 'HOT') summary.hotLeadsSynced++;\n  if (data._hubspotDealId) summary.dealsCreated++;\n\n  summary.leads.push({\n    contacto: data.contacto,\n    empresa: data.empresa,\n    categoria: data.categoria,\n    score: data.score,\n    action: data._syncAction,\n    hubspotId: data._hubspotContactId\n  });\n}\n\nreturn [{ json: summary }];"
      },
      "id": "f4a5b6c7-d8e9-0123-fabc-234567890fab",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-hot-synced",
