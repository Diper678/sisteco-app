      "typeVersion": 1.1,
      "position": [1300, 600]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.cloudflare.com/client/v4/accounts/{{ $('Config').first().json.cloudflare_account_id }}/browser-rendering/crawl/{{ $('Start Crawl').first().json.result.id }}/results?page=1&per_page=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.cloudflare_api_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "cf-disc-0001-4000-a000-000000000009",
      "name": "Get Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Config').first().json;\nconst data = $input.first().json;\nconst records = (data.result && data.result.records) || data.result || [];\n\nconst leads = [];\nconst seen = new Set();\n\nfor (const record of records) {\n  const items = record.json || record.data || [record];\n  const itemList = Array.isArray(items) ? items : [items];\n  \n  for (const item of itemList) {\n    if (!item.empresa && !item.email) continue;\n    \n    // Deduplicate by empresa+email\n    const key = (item.empresa || '') + '|' + (item.email || '');\n    if (seen.has(key)) continue;\n    seen.add(key);\n    \n    leads.push({\n      json: {\n        empresa: item.empresa || null,\n        rut: item.rut || null,\n        email: item.email || null,\n        telefono: item.telefono || null,\n        ciudad: item.ciudad || null,\n        giro: item.giro || null,\n        url_origen: record.url || null,\n        fecha_descubrimiento: new Date().toISOString().substring(0, 10),\n        fuente: 'cloudflare_crawl'\n      }\n    });\n  }\n}\n\nif (leads.length === 0) {\n  return [{ json: { empty: true, message: 'No leads found in crawl results' } }];\n}\n\nreturn leads;"
      },
      "id": "cf-disc-0001-4000-a000-000000000010",
