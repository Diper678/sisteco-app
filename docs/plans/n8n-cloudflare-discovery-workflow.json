      "id": "cf-disc-0001-4000-a000-000000000002",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 500]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    cloudflare_account_id: $env.CF_ACCOUNT_ID || 'CONFIGURE_ME',\n    cloudflare_api_token: $env.CF_API_TOKEN || 'CONFIGURE_ME',\n    // URLs to crawl — Chilean business directories\n    crawl_urls: [\n      'https://www.emol.com/economia/empresas/',\n      'https://www.df.cl/empresas',\n      'https://www.registrodeempresas.cl'\n    ],\n    enrichment_webhook: ($env.N8N_WEBHOOK_URL || 'https://primary-production-24f87.up.railway.app') + '/webhook/enriquecer-lead',\n    enrichment_api_key: $env.ENRICHMENT_API_KEY || 'sisteco-internal',\n    sheet_id: $env.LEADS_CRUDOS_SHEET_ID || '1o9edhOg3LJxUx25x8Ecs3zAOrkhbtXlps5uCjGXVdVI',\n    max_pages: 50,\n    crawl_id: null\n  }\n}];"
      },
      "id": "cf-disc-0001-4000-a000-000000000003",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.cloudflare.com/client/v4/accounts/{{ $json.cloudflare_account_id }}/browser-rendering/crawl",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.cloudflare_api_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $json.crawl_urls[0] }}\",\n  \"maxPages\": {{ $json.max_pages }},\n  \"jsonOptions\": {\n    \"prompt\": \"Extract company information: empresa (company name), rut (Chilean tax ID if visible), email, telefono (phone), ciudad (city), giro (business activity)\",\n    \"schema\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"empresa\": { \"type\": \"string\" },\n          \"rut\": { \"type\": \"string\" },\n          \"email\": { \"type\": \"string\" },\n          \"telefono\": { \"type\": \"string\" },\n          \"ciudad\": { \"type\": \"string\" },\n          \"giro\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "cf-disc-0001-4000-a000-000000000004",
      "name": "Start Crawl",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 400],
      "continueOnFail": true
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "minutes"
      },
      "id": "cf-disc-0001-4000-a000-000000000005",
      "name": "Esperar Crawl",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [780, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.cloudflare.com/client/v4/accounts/{{ $('Config').first().json.cloudflare_account_id }}/browser-rendering/crawl/{{ $('Start Crawl').first().json.result.id || $json.crawl_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.cloudflare_api_token }}"
            }
          ]
        },
        "options": {}
      },
